#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail

PROJECT_DIR="{{ restic_exporter_project_dir }}"
ENTRYPOINT_MODULE="exporter.exporter"

if [[ ! -d "${PROJECT_DIR}" ]]; then
  echo "Project directory does not exist: ${PROJECT_DIR}" >&2
  exit 1
fi

cd "${PROJECT_DIR}"

if [[ -x "${PROJECT_DIR}/.venv/bin/python" ]]; then
  exec "${PROJECT_DIR}/.venv/bin/python" -m "${ENTRYPOINT_MODULE}"
fi

echo "Python venv not found at ${PROJECT_DIR}/.venv/bin/python" >&2
exit 1
