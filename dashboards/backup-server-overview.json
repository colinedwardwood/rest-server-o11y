          "legendFormat": "Total"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "node_filesystem_size_bytes{instance=\"$instance\", mountpoint=\"$mountpoint\"} - node_filesystem_avail_bytes{instance=\"$instance\", mountpoint=\"$mountpoint\"}",
          "legendFormat": "Used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
